rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Branding and system configuration (store logo, title bar, etc.)
    match /branding/{docId} {
      allow read, write: if true;
    }

    // Cashier accounts
    match /cashierAccounts/{cashierId} {
      allow read, write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Raw ingredients inventory
    match /ingredients/{ingredientId} {
      allow read, write: if true;
    }

    // POS Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Inventory audit mutations
    match /inventoryMutations/{mutationId} {
      allow read, write: if true;
    }
  }
}
